{
	"name": "xchert/exception",
	"description": "A Symfony bundle for structured exception handling, error mapping, and JSON-serializable error responses.",
	"type": "library",
	"keywords": [
		"exception",
		"error-handling",
		"symfony",
		"symfony-bundle",
		"http-exception",
		"error-mapping",
		"validation",
		"json-response"
	],
	"license": "MIT",
	"authors": [
		{
			"name": "Dustin Simon"
		}
	],
	"support": {
		"issues": "https://github.com/x-chert/exception/issues",
		"source": "https://github.com/x-chert/exception"
	},
	"autoload": {
		"psr-4": {
			"Xchert\\Exception\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Xchert\\Exception\\Test\\": "tests/"
		}
	},
	"require": {
		"php": "^8.4",
		"symfony/http-kernel": "^8.1",
		"symfony/validator": "^8.1",
		"symfony/dependency-injection": "^8.1",
		"symfony/config": "^8.1",
		"symfony/uid": "^8.1",
		"xchert/util": "^1.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.4",
		"symfony/framework-bundle": "^8.1",
		"symfony/yaml": "^8.1"
	},
	"archive": {
		"exclude": [
			"/.github"
		]
	}
}
